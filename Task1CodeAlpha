import csv
import logging
import re
import time
from typing import Dict, List, Optional
import pandas as pd
import requests
from bs4 import BeautifulSoup
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)
class WebScraperPipeline:
    def __init__(self, base_url: str):
        self.base_url = base_url
        self.headers = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/120.0.0.0 Safari/537.36"
            )
        }
        self.raw_data: List[Dict[str, str]] = []
        self.cleaned_df: Optional[pd.DataFrame] = None
    def fetch_page_content(self, url: str) -> Optional[str]:
        """Fetches HTML response from target web page."""
        try:
            response = requests.get(url, headers=self.headers, timeout=10)
            if response.status_code == 200:
                return response.text
            else:
                logging.warning(
                    f"Failed to fetch {url}. Status code: {response.status_code}"
                )
                return None
        except requests.RequestException as e:
            logging.error(f"Network error while requesting {url}: {e}")
            return None
    def scrape_pages(self, max_pages: int = 3) -> List[Dict[str, str]]:
        """Handles pagination, DOM parsing, and raw data extraction."""
        logging.info(f"Starting scraping process for up to {max_pages} pages...")
        for page_num in range(1, max_pages + 1):
            target_page_url = f"{self.base_url}/page/{page_num}/"
            logging.info(f"Scraping Page {page_num}: {target_page_url}")
            html_content = self.fetch_page_content(target_page_url)
            if not html_content:
                break
            soup = BeautifulSoup(html_content, "html.parser")
            quote_containers = soup.find_all("div", class_="quote")
            if not quote_containers:
                logging.info("No more quote elements found on page.")
                break
            for container in quote_containers:
                quote_text = container.find("span", class_="text").text
                author_name = container.find("small", class_="author").text
                tag_elements = container.find_all("a", class_="tag")
                tags = [tag.text for tag in tag_elements]
                self.raw_data.append({
                    "quote_raw": quote_text,
                    "author_raw": author_name,
                    "tags_raw": ", ".join(tags) if tags else None
                })
            time.sleep(1)
        logging.info(f"Scraping completed. Extracted {len(self.raw_data)} raw records.")
        return self.raw_data
    def clean_and_transform_data() -> pd.DataFrame:
        if not self.raw_data:
            raise ValueError("No raw data available. Execute `scrape_pages()` first.")
        logging.info("Initiating Data Cleaning and Preprocessing Workflow...")
        df = pd.DataFrame(self.raw_data)
        initial_count = len(df)
        df = df.drop_duplicates()
        logging.info(f"Removed {initial_count - len(df)} duplicate row(s).")
        df["tags_raw"] = df["tags_raw"].fillna("Uncategorized")
        df["quote_clean"] = df["quote_raw"].apply(
            lambda x: re.sub(r'[“"”]', "", x).strip()
        )
        df["author_clean"] = df["author_raw"].apply(lambda x: x.strip().title())
        df["character_length"] = df["quote_clean"].apply(len)
        df["word_count"] = df["quote_clean"].apply(lambda x: len(x.split()))
        final_df = df[[
            "quote_clean",
            "author_clean",
            "tags_raw",
            "word_count",
            "character_length"
        ]].rename(columns={
            "quote_clean": "Quote",
            "author_clean": "Author",
            "tags_raw": "Tags",
            "word_count": "Word_Count",
            "character_length": "Char_Length"
        })
        self.cleaned_df = final_df
        logging.info("Data processing and workflow completed successfully.")
        return final_df
    def export_dataset(self, filename: str = "custom_scraped_dataset.csv") -> None:
        """Exports processed DataFrame to CSV file."""
        if self.cleaned_df is None:
            raise ValueError("Cleaned data not available for export.")
        self.cleaned_df.to_csv(filename, index=False, encoding="utf-8")
        logging.info(f"Dataset saved successfully to '{filename}'.")
if __name__ == "__main__":
    URL = "http://quotes.toscrape.com"
    pipeline = WebScraperPipeline(base_url=URL)
    pipeline.scrape_pages(max_pages=3)
    processed_data = pipeline.clean_and_transform_data()
    pipeline.export_dataset("final_scraped_quotes.csv")
    print("\n" + "="*40)
    print("      DATASET PREVIEW & SUMMARY      ")
    print("="*40)
    print(processed_data.head())
    print("\n--- Summary Statistics ---")
    print(processed_data.describe())
